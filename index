        },
        {
            question: "¿Qué virtud de María se refleja cuando visitó a su prima Isabel cuando más la necesitaba?",
            options: [
                "El servicio, que la llevaba a estar dispuesta a ayudar a los demás y preocuparse por sus necesidades.",
                "La fe, que la hacía creer en Dios con todo su corazón incluso en los momentos más difíciles de su vida.",
                "El amor, que le permitía amar a Jesús con un amor incondicional, con paciencia, comprensión y entrega.",
                "La humildad, que la mantenía como una persona sencilla y modesta a pesar de haber sido elegida por Dios.",
                "La obediencia, que la llevaba a aceptar la voluntad de Dios incluso cuando no entendía lo que sucedía.",
                "La fortaleza, que la llevaba a enfrentar los desafíos con valentía y a no perder la esperanza en la cruz.",
                "La pureza, que la llevó a consagrarse a Dios desde su infancia y a mantenerse fiel a sus promesas.",
                "La caridad, que la impulsaba a dar limosna a los pobres y a compartir sus bienes con los necesitados."
            ],
            correct: 0
        },
        {
            question: "¿Qué hecho histórico llevó a que el 24 de mayo se declarara como el día de María Auxiliadora?",
            options: [
                "El Papa Pío VII prometió declarar la fiesta si llegaba libre a Roma, y lo logró inesperadamente el 24 de mayo de 1814.",
                "San Juan Bosco terminó la construcción de la Basílica de María Auxiliadora en Turín el 24 de mayo de 1868.",
                "La batalla de Lepanto se libró el 24 de mayo de 1571, donde la Virgen protegió a la cristiandad de los turcos.",
                "La Virgen se apareció a San Juan Bosco el 24 de mayo de 1860, pidiéndole que le construyera un templo en Turín.",
                "El Papa San Pío V ordenó rezar la advocación en las letanías el 24 de mayo de 1572, tras la victoria en Lepanto.",
                "Los católicos del sur de Alemania hicieron una promesa a la Virgen el 24 de mayo de 1600 para terminar la guerra.",
                "San Juan Damasceno propagó la jaculatoria 'María Auxiliadora' el 24 de mayo de 749 en Constantinopla.",
                "San Juan Crisóstomo proclamó a María como 'Auxilio potentísimo de Dios' el 24 de mayo del año 345."
            ],
            correct: 0
        }
    ];

    // Variables del juego
    let currentQuestions = [];
    let currentQuestionIndex = 0;
    let score = 0;
    let failures = 0;
    let canAnswer = true;

    // Elementos del DOM
    const startScreen = document.getElementById('start-screen');
    const quizScreen = document.getElementById('quiz-screen');
    const resultScreen = document.getElementById('result-screen');
    const questionCounter = document.getElementById('question-counter');
    const scoreDisplay = document.getElementById('score-display');
    const progressBar = document.getElementById('progress-bar');
    const questionText = document.getElementById('question-text');
    const optionsContainer = document.getElementById('options-container');
    const feedback = document.getElementById('feedback');
    const btnNext = document.getElementById('btn-next');
    const resultIcon = document.getElementById('result-icon');
    const resultTitle = document.getElementById('result-title');
    const resultScore = document.getElementById('result-score');
    const resultMessage = document.getElementById('result-message');

    // Función para mezclar un array (Fisher-Yates)
    function shuffleArray(array) {
        for (let i = array.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [array[i], array[j]] = [array[j], array[i]];
        }
        return array;
    }

    // Iniciar el Quiz
    function startQuiz() {
        // Seleccionar 10 preguntas aleatorias del banco de 16
        currentQuestions = shuffleArray([...questionBank]).slice(0, 10);
        
        // Mezclar las 8 opciones de cada pregunta seleccionada
        currentQuestions = currentQuestions.map(q => {
            const shuffledOptions = shuffleArray([...q.options]);
            const correctAnswerText = q.options[q.correct];
            const newCorrectIndex = shuffledOptions.indexOf(correctAnswerText);
            return {
                question: q.question,
                options: shuffledOptions,
                correct: newCorrectIndex
            };
        });

        currentQuestionIndex = 0;
        score = 0;
        failures = 0;
        
        startScreen.classList.remove('active');
        quizScreen.classList.add('active');
        loadQuestion();
    }

    // Cargar la pregunta actual
    function loadQuestion() {
        canAnswer = true;
        feedback.classList.remove('show', 'success', 'error');
        btnNext.classList.remove('show');
        
        const q = currentQuestions[currentQuestionIndex];
        
        // Actualizar encabezado y progreso
        questionCounter.textContent = `Pregunta ${currentQuestionIndex + 1} de 10`;
        scoreDisplay.textContent = `Aciertos: ${score} | Fallos: ${failures}`;
        progressBar.style.width = `${((currentQuestionIndex) / 10) * 100}%`;
        
        // Cargar texto de la pregunta
        questionText.textContent = q.question;
        
        // Cargar opciones
        optionsContainer.innerHTML = '';
        const letters = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'];
        
        q.options.forEach((option, index) => {
            const optionDiv = document.createElement('div');
            optionDiv.classList.add('option');
            optionDiv.innerHTML = `
                <div class="option-letter">${letters[index]}</div>
                <div>${option}</div>
            `;
            optionDiv.onclick = () => selectOption(index, optionDiv);
            optionsContainer.appendChild(optionDiv);
        });
    }

    // Seleccionar una opción
    function selectOption(selectedIndex, optionElement) {
        if (!canAnswer) return;
        canAnswer = false;

        const q = currentQuestions[currentQuestionIndex];
        const allOptions = document.querySelectorAll('.option');
        
        // Deshabilitar clics en todas las opciones
        allOptions.forEach(opt => opt.style.pointerEvents = 'none');

        if (selectedIndex === q.correct) {
            // Respuesta Correcta
            optionElement.classList.add('correct');
            score++;
            feedback.textContent = "¡Correcto! Muy bien.";
            feedback.className = "feedback show success";
        } else {
            // Respuesta Incorrecta
            optionElement.classList.add('incorrect');
            // Mostrar cuál era la correcta
            allOptions[q.correct].classList.add('correct');
            failures++;
            feedback.textContent = "Incorrecto. La respuesta correcta está resaltada en verde.";
            feedback.className = "feedback show error";
        }

        // Actualizar marcador
        scoreDisplay.textContent = `Aciertos: ${score} | Fallos: ${failures}`;

        // Verificar si perdió (2 fallos)
        if (failures >= 2) {
            setTimeout(() => endQuiz(false), 1500);
            return;
        }

        // Mostrar botón de siguiente
        btnNext.classList.add('show');
        
        // Si es la última pregunta, cambiar texto del botón
        if (currentQuestionIndex === currentQuestions.length - 1) {
            btnNext.textContent = "Ver Resultados";
        }
    }

    // Siguiente pregunta
    function nextQuestion() {
        currentQuestionIndex++;
        if (currentQuestionIndex < currentQuestions.length) {
            loadQuestion();
        } else {
            endQuiz(true);
        }
    }

    // Finalizar el Quiz
    function endQuiz(completed) {
        quizScreen.classList.remove('active');
        resultScreen.classList.add('active');
        
        if (!completed || failures >= 2) {
            // Perdió
            resultIcon.textContent = "😕";
            resultTitle.textContent = "Lo siento, has perdido";
            resultTitle.style.color = "var(--danger)";
            resultScore.textContent = `Aciertos: ${score} | Fallos: ${failures}`;
            resultMessage.textContent = "Has cometido 2 o más fallos. Recuerda que necesitas al menos 9 respuestas correctas para aprobar. ¡Estudia un poco más y vuelve a intentarlo!";
        } else {
            // Ganó
            resultIcon.textContent = "🎉";
            resultTitle.textContent = "¡Felicidades!";
            resultTitle.style.color = "var(--success)";
            resultScore.textContent = `Has acertado ${score} de 10 preguntas.`;
            resultMessage.textContent = "Has demostrado un excelente conocimiento de los temas. ¡Sigue así!";
        }
    }
</script>

